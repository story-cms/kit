@bibleId = 65eec8e0b60e656b-01
@passageId = JHN.1.1-JHN.1.5

###
# list bibles (scripture.api.bible)
GET https://api.scripture.api.bible/v1/bibles HTTP/1.1
api-key: {{bibleApiKey}}

###
# get a passage (scripture.api.bible)
GET https://api.scripture.api.bible/v1/bibles/{{bibleId}}/passages/{{passageId}}?content-type=text&include-titles=false HTTP/1.1
api-key: {{bibleApiKey}}

###
# list bibles (rest.api.bible)
GET https://rest.api.bible/v1/bibles HTTP/1.1
api-key: {{bibleApiKey}}

###
# get a bible (rest.api.bible)
GET https://rest.api.bible/v1/bibles/{{bibleId}} HTTP/1.1
api-key: {{bibleApiKey}}

###
# get a passage (rest.api.bible)
GET https://rest.api.bible/v1/bibles/{{bibleId}}/passages/{{passageId}}?content-type=text&include-titles=false HTTP/1.1
api-key: {{bibleApiKey}}
