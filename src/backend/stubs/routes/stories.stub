{{{
  exports({ to: app.makePath('start/routes/stories.ts') })
}}}
import router from '@adonisjs/core/services/router';

const StoriesController = () => import('#controllers/stories_controller');
const ChaptersController = () => import('#controllers/chapters_controller');
const DraftsController = () => import('#controllers/drafts_controller');

export default () => {
  // stories
  router.get(':locale/story', [StoriesController, 'index']);
  router.get(':locale/story/create', [StoriesController, 'create']);
  router.post(':locale/story', [StoriesController, 'store']);
  router
    .get(':locale/story/:storyId/edit', [StoriesController, 'edit'])
    .where('storyId', router.matchers.number());
  router
    .delete(':locale/story/:storyId', [StoriesController, 'delete'])
    .where('storyId', router.matchers.number());
  router
    .post(':locale/story/:storyId/publish', [StoriesController, 'publish'])
    .where('storyId', router.matchers.number());
  router
    .post(':locale/story/:storyId', [StoriesController, 'update'])
    .where('storyId', router.matchers.number());

  // chapters
  router.on('/story/:storyId').redirect('chapters.index', {
    locale: 'en',
    storyId: 1,
  });
  router
    .get(':locale/story/:storyId', [ChaptersController, 'index'])
    .where('storyId', router.matchers.number());
  router
    .get(':locale/story/:storyId/chapter/:number', [ChaptersController, 'preview'])
    .where('storyId', router.matchers.number())
    .where('number', router.matchers.number());

  // drafts
  router
    .get(':locale/story/:storyId/draft/:number/edit', [DraftsController, 'edit'])
    .where('storyId', router.matchers.number())
    .where('number', router.matchers.number());
  router
    .get(':locale/story/:storyId/draft/create', [DraftsController, 'create'])
    .where('storyId', router.matchers.number());
  router
    .delete(':locale/story/:storyId/draft/:id', [DraftsController, 'delete'])
    .where('storyId', router.matchers.number())
    .where('id', router.matchers.number());
  router
    .post(':locale/story/:storyId/draft/:id/save', [DraftsController, 'save'])
    .where('storyId', router.matchers.number())
    .where('id', router.matchers.number());
  router
    .post(':locale/story/:storyId/draft/:id/submit', [DraftsController, 'submit'])
    .where('storyId', router.matchers.number())
    .where('id', router.matchers.number());
  router
    .post(':locale/story/:storyId/draft/:id/publish', [DraftsController, 'publish'])
    .where('storyId', router.matchers.number())
    .where('id', router.matchers.number());
  router
    .post(':locale/story/:storyId/draft/:id/reject', [DraftsController, 'reject'])
    .where('storyId', router.matchers.number())
    .where('id', router.matchers.number());
};
