{{{
  exports({ to: app.makePath('start/routes/api.ts') })
}}}
import router from '@adonisjs/core/services/router';
import { middleware } from '#start/kernel';
import { idMatcher } from '@story-cms/kit';
const StreamController = () => import('#controllers/streams_controller');
const ChaptersController = () => import('#controllers/chapters_controller');
const PreviewController = () => import('#controllers/preview_controller');
const PagesController = () => import('#controllers/pages_controller');
const IndicesController = () => import('#controllers/indices_controller');
const InvitationsController = () => import('#controllers/invitations_controller');
const StoriesController = () => import('#controllers/stories_controller');
const LocaleController = () => import('#controllers/locale_controller');

export default () => {
  router
    .group(() => {
      router
        .get('/preview/:number', [PreviewController, 'get'])
        .where('number', idMatcher);

      router.get('/stream/:id', [StreamController, 'get']).where('id', idMatcher);
      router
        .get('/drop/:id', [StreamController, 'getDrop'])
        .where('id', idMatcher);

      router
        .get('/chapter/:number', [ChaptersController, 'get'])
        .where('number', idMatcher);

      router
        .get('/chapter/from/:from/to/:to', [ChaptersController, 'range'])
        .where('from', idMatcher)
        .where('to', idMatcher);

      router.get('/index', [IndicesController, 'index']);
      router.get('/stories', [StoriesController, 'home']);

      router.get('/page', [PagesController, 'get']);

      router.get('/invitations', [InvitationsController, 'get']);

      router.get('/locale', [LocaleController, 'index']);
    })
    .use(middleware.noIndex())
    .prefix('/api/v1');
};
